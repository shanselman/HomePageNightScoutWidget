# Copy to .env. Never commit .env or paste a real token into services.yaml.
NIGHTSCOUT_URL=https://nightscout.example.com
# Recommended for a protected site: a Nightscout token with the readable role.
NIGHTSCOUT_TOKEN=
# Alternative: raw API secret (the adapter hashes it). Prefer a read-only token.
NIGHTSCOUT_API_SECRET=
NIGHTSCOUT_UNITS=mg/dL
STALE_AFTER_MINUTES=10
POLL_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=8
HOST=127.0.0.1
PORT=3001
ALLOW_HTTP=false
# Optional adapter authentication; this is NOT your Nightscout token.
WIDGET_API_KEY=
# Existing Docker network that Homepage has joined (Compose deployment only).
HOMEPAGE_NETWORK=homepage_default
